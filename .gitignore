# === Secrets & private data (NEVER commit) ===
# The Papyrus newsletter subscriber list (real emails)
backend/api/_private/
**/_private/
*.jsonl

# Real DB credentials, if you ever put them in a local override
backend/api/config.local.php
.env
.env.*

# === Generated / regenerable artifacts ===
# Pipeline-generated seed (rebuilt by fetch_worldbank.py) — TRACKED so the
# scheduled "Refresh Egypt data" GitHub Action can commit refreshed values and
# they carry a readable, cited audit trail. (Was ignored; now versioned.)
# Local SQLite test DB (rebuilt by backend/test/build_test_db.py)
*.sqlite
*.sqlite3
backend/test/*.sqlite
# ...except the bundled read-only knowledge base, which we DO ship (it's the
# zero-setup production data source for the KB API on SQLite).
!backend/data/egybi_kb.sqlite
# API file cache
backend/cache/
**/cache/

