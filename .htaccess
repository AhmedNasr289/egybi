# EgyBI — repo root = Hostinger public_html (Git deploy target).
#
# Hostinger's Git integration deploys the WHOLE repository into public_html.
# The actual website lives in the site/ subfolder, and the repo also contains
# non-web folders (the egybi/ docs vault and backend/ tooling) that must never
# be served. This file makes Apache treat site/ as the web root and blocks the
# rest — so no document-root change is needed on the hosting side.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 0) Canonical host: send www -> non-www, permanently.
    #    Both hostnames served 200 independently, which splits search signals
    #    and lets the same page be indexed under two URLs. rel=canonical already
    #    hints at the right one, but a 301 settles it rather than suggesting it.
    #
    #    MUST be first. If it ran after rule 3 the request would already have
    #    been rewritten into site/, and the redirect would leak that internal
    #    path into the public URL.
    #
    #    %1 is the captured non-www host rather than a literal, so this keeps
    #    working if the domain ever changes. Redirecting straight to https://
    #    also collapses http://www -> https://non-www into ONE hop instead of a
    #    two-step chain. The query string carries over automatically, since the
    #    substitution contains no '?'.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

    # 1) Hard-block the private folders that Git also deploys here.
    #    (Business/pricing vault + build tooling — 403, never served.)
    RewriteRule ^(egybi|backend)(/|$) - [F]

    # 2) Serve robots.txt from THIS (document-root) copy, not the site/ one.
    #    The host special-cases /robots.txt before rewrites, so keeping a real
    #    file here is what actually gets served to crawlers.
    RewriteRule ^robots\.txt$ - [L]

    # 3) Serve everything else from the site/ web root. Requests already inside
    #    /site/ are left alone so there is no rewrite loop. Anything that isn't
    #    under site/ (README.md, GO-LIVE.md, egy_raw.geojson, etc.) maps to a
    #    non-existent site/<name> and 404s — i.e. only site/ content is public.
    RewriteCond %{REQUEST_URI} !^/site/
    RewriteRule ^(.*)$ site/$1 [L]
</IfModule>

# ---------------------------------------------------------------------------
# Security headers.
#
# "always" matters: without it these are skipped on error responses (403/404),
# which is exactly where an attacker spends their time.
#
# Note the host already injects its own "Content-Security-Policy:
# upgrade-insecure-requests". Two CSP headers both apply and intersect, so the
# frame-ancestors policy below composes with it rather than replacing it.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    # Clickjacking. The sign-in modal and the Google button are the real target:
    # framed invisibly over an attacker's page, a click lands on our login UI.
    # X-Frame-Options is the legacy control, frame-ancestors the modern one -
    # both are set because older browsers ignore the latter. This does NOT
    # affect the Google Identity iframe we embed; that is frame-src, and
    # frame-ancestors only governs who may embed US.
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Content-Security-Policy "frame-ancestors 'self'"

    # Stop browsers guessing a MIME type. Without this, a file served as
    # text/plain that happens to contain markup can be sniffed as HTML and run.
    Header always set X-Content-Type-Options "nosniff"

    # Send the full URL only to ourselves; cross-origin gets the bare origin.
    # Keeps challenge/solution paths out of third-party referer logs.
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Drop access to device APIs the site never uses, so injected script cannot
    # reach for them either. Topics/interest-cohort is deliberately NOT listed:
    # restricting it would interfere with AdSense.
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=()"

    # HSTS. Browsers ignore this over plain HTTP, so it is safe to set here.
    # No "preload" directive on purpose - preloading is submitted to a browser
    # list and is genuinely hard to undo.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Fallback if mod_rewrite is off on this host: at least deny sensitive types.
<FilesMatch "\.(md|sql|sqlite|sqlite3|geojson|log)$">
    Require all denied
</FilesMatch>
