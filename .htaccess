# EgyBI — repo root = Hostinger public_html (Git deploy target).
#
# Hostinger's Git integration deploys the WHOLE repository into public_html.
# The actual website lives in the site/ subfolder, and the repo also contains
# non-web folders (the egybi/ docs vault and backend/ tooling) that must never
# be served. This file makes Apache treat site/ as the web root and blocks the
# rest — so no document-root change is needed on the hosting side.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 0) Canonical host: send www -> non-www, permanently.
    #    Both hostnames served 200 independently, which splits search signals
    #    and lets the same page be indexed under two URLs. rel=canonical already
    #    hints at the right one, but a 301 settles it rather than suggesting it.
    #
    #    MUST be first. If it ran after rule 3 the request would already have
    #    been rewritten into site/, and the redirect would leak that internal
    #    path into the public URL.
    #
    #    %1 is the captured non-www host rather than a literal, so this keeps
    #    working if the domain ever changes. Redirecting straight to https://
    #    also collapses http://www -> https://non-www into ONE hop instead of a
    #    two-step chain. The query string carries over automatically, since the
    #    substitution contains no '?'.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

    # 1) Hard-block the private folders that Git also deploys here.
    #    (Business/pricing vault + build tooling — 403, never served.)
    RewriteRule ^(egybi|backend)(/|$) - [F]

    # 2) Serve robots.txt from THIS (document-root) copy, not the site/ one.
    #    The host special-cases /robots.txt before rewrites, so keeping a real
    #    file here is what actually gets served to crawlers.
    RewriteRule ^robots\.txt$ - [L]

    # 2b) Retired sections (2026-08-07). EgyBI is an encyclopaedia of Egypt
    #     now, not a SQL practice platform, and these two pages have no unique
    #     subject worth preserving — unlike the 123 former challenge URLs under
    #     /practice/, which each keep their own page and return 200 with the
    #     question they always asked plus an onward link. A 301 is right here
    #     and wrong there: collapsing 123 distinct pages onto a handful of
    #     section anchors reads to a crawler as a soft 404 and loses them.
    #
    #     MUST come before rule 3, which would otherwise rewrite the request
    #     into site/ and serve the file before this rule is ever considered.
    #     The trailing $ matters: without it this would also swallow
    #     /practice/<slug>.html, redirecting away the very pages being kept.
    RewriteRule ^practice\.html$ /explore.html [L,R=301]
    RewriteRule ^tracks\.html$ /explore.html [L,R=301]

    # 3) Serve everything else from the site/ web root. Requests already inside
    #    /site/ are left alone so there is no rewrite loop. Anything that isn't
    #    under site/ (README.md, GO-LIVE.md, egy_raw.geojson, etc.) maps to a
    #    non-existent site/<name> and 404s — i.e. only site/ content is public.
    RewriteCond %{REQUEST_URI} !^/site/
    RewriteRule ^(.*)$ site/$1 [L]
</IfModule>

# ---------------------------------------------------------------------------
# The page a visitor gets for a URL that is not here.
#
# Without this, Apache serves its own default: no header, no way back, and no
# sign the site is still working. The path is /site/404.html rather than
# /404.html because ErrorDocument resolves against the real document root,
# which is the repo root — the rewrite above only affects incoming requests.
#
# site/404.html is generated by build_static_pages.py so it carries the shared
# nav and footer, and every path inside it is root-relative: Apache serves the
# same file for /nonsense.html and /practice/nonsense.html, so a relative
# stylesheet would 404 in its own right from the wrong depth and the error page
# would arrive unstyled.
ErrorDocument 404 /site/404.html

# ---------------------------------------------------------------------------
# Security headers.
#
# "always" matters: without it these are skipped on error responses (403/404),
# which is exactly where an attacker spends their time.
#
# The host injects its own "Content-Security-Policy: upgrade-insecure-requests".
# "Header always set" REPLACES that header rather than adding a second one --
# confirmed against the live response, which came back with exactly one CSP.
# So upgrade-insecure-requests is restated in our own policy below; without it
# adding these headers would have silently dropped a control that was there.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    # Clickjacking. The sign-in modal and the Google button are the real target:
    # framed invisibly over an attacker's page, a click lands on our login UI.
    # X-Frame-Options is the legacy control, frame-ancestors the modern one -
    # both are set because older browsers ignore the latter. This does NOT
    # affect the Google Identity iframe we embed; that is frame-src, and
    # frame-ancestors only governs who may embed US.
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Content-Security-Policy "frame-ancestors 'self'; upgrade-insecure-requests"

    # Stop browsers guessing a MIME type. Without this, a file served as
    # text/plain that happens to contain markup can be sniffed as HTML and run.
    Header always set X-Content-Type-Options "nosniff"

    # Send the full URL only to ourselves; cross-origin gets the bare origin.
    # Keeps challenge/solution paths out of third-party referer logs.
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Drop access to device APIs the site never uses, so injected script cannot
    # reach for them either. Topics/interest-cohort is deliberately NOT listed:
    # restricting it would interfere with AdSense.
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=()"

    # HSTS. Browsers ignore this over plain HTTP, so it is safe to set here.
    # No "preload" directive on purpose - preloading is submitted to a browser
    # list and is genuinely hard to undo.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Fallback if mod_rewrite is off on this host.
#
# Everything above depends on mod_rewrite. If the module is unavailable, or a
# plan change sets AllowOverride None, rules 1 and 3 vanish and the whole repo
# becomes fetchable at its literal path. The old list here covered five
# extensions and missed .py, .yml, .csv, .json and - most consequentially -
# .key, which is where the analytics secret lives. These two directives do not
# depend on mod_rewrite.
<FilesMatch "\.(md|sql|sqlite|sqlite3|geojson|log|py|yml|yaml|csv|jsonl|key|ini|bak)$">
    Require all denied
</FilesMatch>

# Directory-level deny that survives mod_rewrite being off. RedirectMatch is
# mod_alias, a different module, so this is genuine defence in depth rather
# than a second copy of the same assumption.
<IfModule mod_alias.c>
    RedirectMatch 404 ^/(egybi|backend|\.git|\.github)(/|$)
</IfModule>
